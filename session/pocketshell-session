#!/bin/bash
# Plasma runs KWin as a systemd user service that outlives a session switch;
# wait for it to give up the display before Hyprland asks for it.
systemctl --user stop plasma-workspace.target 2>/dev/null
for _ in $(seq 1 50); do
  systemctl --user is-active --quiet plasma-kwin_wayland.service || break
  sleep 0.2
done
unset WAYLAND_DISPLAY DISPLAY

# KDE apps started from here rebuild KDE's shared app cache (ksycoca) when
# something changed. Without Plasma's menu prefix that rebuild finds no
# applications.menu, and Plasma Mobile 6.8's app drawer (built from the menu)
# then shows almost nothing. Use the same menu Plasma does.
if [ -z "$XDG_MENU_PREFIX" ] && [ -f /etc/xdg/menus/plasma-applications.menu ]; then
  export XDG_MENU_PREFIX=plasma-
fi

# The Back button goes to Pocket Shell while it runs (bin/pocket-back), and
# back to InputPlumber's own handling when the session ends.
restored=0
restore() {
  [ "$restored" = 1 ] && return
  restored=1
  [ -x /usr/local/bin/pocket-back ] && /usr/local/bin/pocket-back off
}
trap restore EXIT
trap 'restore; exit 143' TERM HUP INT
[ -x /usr/local/bin/pocket-back ] && /usr/local/bin/pocket-back on

start-hyprland
