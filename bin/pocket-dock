#!/bin/bash
# pocket-dock: what happens when a monitor is plugged into the USB-C port.
#
#   pocket-dock watch    follow plugging and unplugging (Hyprland starts this,
#                        see hypr/hyprland.lua); stops when Hyprland does
#   pocket-dock on       do the plug-in steps now
#   pocket-dock off      do the unplug steps now
#   pocket-dock status   show what's connected and where sound goes
#   pocket-dock mode [match|smooth|rp5]
#                        show or choose how the picture works (saved; applied
#                        right away if a monitor is connected)
#
# Picture, two modes:
#   match (default)  everything is drawn for the monitor: its biggest 16:9
#                    resolution up to 1440p, at the highest refresh rate up
#                    to 120 Hz,
#                    scaled so the shell has the same layout as on the RP5.
#                    The RP5 screen shows a scaled-down copy, and touch
#                    follows it.
#   smooth           the same, but the highest refresh rate (up to 120 Hz)
#                    comes first, then the biggest resolution at that rate
#                    (e.g. 1080p at 120 Hz instead of 1440p at 60 Hz when an
#                    adapter can't do both).
#   rp5              everything is drawn for the RP5 screen (1080p, 60 Hz)
#                    and the monitor shows a copy, sent at 1920x1080@60 when
#                    the monitor has that mode.
# Pocket Shell moves to whichever screen is drawn for: this writes its name
# to $XDG_RUNTIME_DIR/pocket-dock/main (see quickshell/Device.qml).
#
# Sound: plugging in adds a "Monitor (USB-C)" sound output and makes it the
# default. Unplugging: the output goes away and the previous default comes
# back.
#
# Sound: pocknix's audio setup only knows the speaker and headphones, but
# the kernel has a DisplayPort output on the audio router. A free playback
# channel (MultiMedia3, hw:0,2) is routed to it and given to PipeWire.
set -u

MAIN=DSI-1
# The built-in screen's Hyprland rule, as in hypr/hyprland.lua
MAIN_RULE='output = "DSI-1", mode = "1080x1920@60", position = "auto", scale = 2, transform = 1'
MAIN_TOUCH_TRANSFORM=1
# Its height in layout pixels (landscape 960x540), which the shell is laid out for
MAIN_HEIGHT=540
MAX_HZ=120.5
# Tallest resolution to draw at; 4K costs a lot more GPU than the SM8250 has to spare
MAX_HEIGHT=1440
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/pocket-shell"
CARD=hw:0
PCM=hw:0,2
ROUTE="DISPLAY_PORT_RX Audio Mixer MultiMedia3"
SINK=pocket-shell.monitor
DRM="${POCKET_DRM:-/sys/class/drm}"
STATE="${XDG_RUNTIME_DIR:-/tmp}/pocket-dock"
POLL=2

say() { echo "pocket-dock: $*" >&2; }

# The plugged-in external output, e.g. DP-1, or nothing
connected_output() {
  local f
  for f in "$DRM"/card*-DP-*/status; do
    [ -r "$f" ] || continue
    if [ "$(cat "$f")" = connected ]; then
      f="${f%/status}"
      echo "${f##*/card[0-9]-}"
      return
    fi
  done
}

# Run Lua in Hyprland; it answers "ok" or the error
hypr() {
  local out
  out="$(hyprctl eval "$1" 2>&1)" || { say "Hyprland: ${out:-no answer}"; return 1; }
  case "$out" in
    ok*|"") return 0 ;;
  esac
  say "Hyprland: $out"
  return 1
}

dock_mode() {
  local m
  m="$(cat "$CONFIG/dock-mode" 2>/dev/null)"
  case "$m" in
    rp5|smooth) echo "$m" ;;
    *) echo match ;;
  esac
}

# The output's modes as Hyprland lists them, e.g. "2560x1440@119.99Hz ..."
modes_of() {
  hyprctl monitors all 2>/dev/null | awk -v out="$1" '
    /^Monitor / { inblk = ($2 == out) }
    inblk && /availableModes:/ { sub(/^[[:space:]]*availableModes:[[:space:]]*/, ""); print; exit }'
}

# The mode to draw at: best_mode OUT res|rate. Only modes up to MAX_HEIGHT
# with a refresh rate from 59 to MAX_HZ. "res" (match): the biggest
# resolution, then the highest rate; "rate" (smooth): the highest rate,
# then the biggest resolution. 16:9 modes first, so the copy on the RP5
# isn't stretched.
best_mode() {
  modes_of "$1" | tr ' ' '\n' | awk -v max="$MAX_HZ" -v maxh="$MAX_HEIGHT" -v by="${2:-res}" '
    function better(px, hz, bpx, bhz) {
      if (by == "rate")
        return hz > bhz + 0.5 || (hz > bhz - 0.5 && px > bpx)
      return px > bpx || (px == bpx && hz > bhz)
    }
    /^[0-9]+x[0-9]+@[0-9.]+Hz$/ {
      m = $0; sub(/Hz$/, "", m)
      split(m, a, "@"); split(a[1], wh, "x")
      hz = a[2] + 0; px = wh[1] * wh[2]
      if (hz < 59 || hz > max || wh[2] > maxh) next
      wide = (wh[1] * 9 == wh[2] * 16)
      if (wide && (wbest == "" || better(px, hz, wpx, whz))) { wpx = px; whz = hz; wbest = m }
      if (abest == "" || better(px, hz, apx, ahz)) { apx = px; ahz = hz; abest = m }
    }
    END { if (wbest != "") print wbest; else if (abest != "") print abest }'
}

has_mode() {  # has_mode OUT 1920x1080 (at 59-61 Hz)
  modes_of "$1" | tr ' ' '\n' | grep -qE "^$2@(59\.|60\.|61\.)"
}

# Built-in screen back to normal: drawn for, touch on it, shell on it
main_restore() {
  hypr "hl.monitor({ $MAIN_RULE, mirror = \"\" })"
  hypr "hl.config({ input = { touchdevice = { output = \"$MAIN\", transform = $MAIN_TOUCH_TRANSFORM } } })"
  rm -f "$STATE/main"
}

# Turn the monitor on (side by side for a moment) so its modes are known
light() {
  hypr "hl.monitor({ output = \"$1\", disabled = false, mode = \"preferred\", position = \"auto\", scale = 2, mirror = \"\" })" || return 1
  local i
  for i in 1 2 3 4 5; do
    [ -n "$(modes_of "$1")" ] && return 0
    sleep 0.4
  done
  return 0
}

video_rp5() {
  local out="$1" mode=preferred
  main_restore
  light "$out" || { say "couldn't set up $out in Hyprland"; return 1; }
  has_mode "$out" 1920x1080 && mode=1920x1080@60
  hypr "hl.monitor({ output = \"$out\", disabled = false, mode = \"$mode\", position = \"auto\", scale = 2, mirror = \"$MAIN\" })" \
    || say "couldn't mirror onto $out"
  say "$out shows a copy of the RP5 screen ($mode)"
}

video_match() {
  local out="$1" by="${2:-res}" mode h scale
  light "$out" || { say "couldn't set up $out in Hyprland"; return 1; }
  mode="$(best_mode "$out" "$by")"
  if [ -z "$mode" ]; then
    say "no mode from 59 to ${MAX_HZ%.*} Hz on $out; using the RP5 screen's picture"
    video_rp5 "$out"
    return
  fi
  h="${mode%@*}"
  h="${h#*x}"
  scale="$(awk -v h="$h" -v m="$MAIN_HEIGHT" 'BEGIN { printf "%.6f", h / m }')"
  hypr "hl.monitor({ output = \"$out\", disabled = false, mode = \"$mode\", position = \"0x0\", scale = $scale, mirror = \"\" })" \
    || { say "couldn't set $out to $mode; using the RP5 screen's picture"; video_rp5 "$out"; return; }
  hypr "hl.monitor({ $MAIN_RULE, mirror = \"$out\" })" || say "couldn't copy $out onto the RP5 screen"
  hypr "hl.config({ input = { touchdevice = { output = \"$out\", transform = $MAIN_TOUCH_TRANSFORM } } })"
  mkdir -p "$STATE"
  printf '%s\n' "$out" >"$STATE/main"
  say "$out runs at ${mode}Hz (scale $scale); the RP5 screen shows a copy"
}

video_on() {
  case "$(dock_mode)" in
    rp5) video_rp5 "$1" ;;
    smooth) video_match "$1" rate ;;
    *) video_match "$1" res ;;
  esac
}

# Route the free channel to DisplayPort: route on|off. Looked up by name,
# since control numbers differ between ALSA devices.
route() {
  local id
  id="$(amixer -D "$CARD" controls 2>/dev/null | grep -F "name='$ROUTE'" | sed -n 's/^numid=\([0-9]*\),.*/\1/p')"
  if [ -z "$id" ]; then
    say "no '$ROUTE' control; no sound on the monitor"
    return 1
  fi
  amixer -D "$CARD" -q cset "numid=$id" "$1"
}

route_state() {
  local id
  id="$(amixer -D "$CARD" controls 2>/dev/null | grep -F "name='$ROUTE'" | sed -n 's/^numid=\([0-9]*\),.*/\1/p')"
  [ -n "$id" ] && amixer -D "$CARD" cget "numid=$id" | sed -n 's/^ *: values=//p'
}

sink_id() {
  pw-cli ls Node 2>/dev/null | awk -v want="node.name = \"$SINK\"" '
    /^[[:space:]]*id [0-9]+,/ { id = $2; sub(",", "", id) }
    index($0, want) { print id; exit }'
}

# Kept running while it exists: reopening the DisplayPort output right after
# closing it can time out.
sink_on() {
  [ -n "$(sink_id)" ] && return 0
  pw-cli create-node adapter "{
    factory.name = api.alsa.pcm.sink
    node.name = $SINK
    node.description = \"Monitor (USB-C)\"
    media.class = Audio/Sink
    api.alsa.path = \"$PCM\"
    audio.format = S16LE
    audio.rate = 48000
    audio.channels = 2
    audio.position = [ FL FR ]
    node.pause-on-idle = false
    session.suspend-timeout-seconds = 0
    object.linger = true
  }" >/dev/null || { say "couldn't create the monitor sound output"; return 1; }
}

sink_off() {
  local id
  id="$(sink_id)"
  [ -n "$id" ] && pw-cli destroy "$id" >/dev/null
}

current_default() {
  pw-metadata 0 default.configured.audio.sink 2>/dev/null | sed -n "s/.*value:'\([^']*\)'.*/\1/p" | head -1
}

set_default() {
  pw-metadata 0 default.configured.audio.sink "$1" Spa:String:JSON >/dev/null
}

dock_on() {
  local out="$1" prev
  mkdir -p "$STATE"
  say "$out connected"
  video_on "$out"
  route on || return 0
  sink_on || return 0
  # Remember the default from before, unless it's already ours
  prev="$(current_default)"
  if [ ! -f "$STATE/default" ] && [ "${prev#*$SINK}" = "$prev" ]; then
    printf '%s' "$prev" >"$STATE/default"
  fi
  sleep 1
  set_default "{\"name\":\"$SINK\"}"
  say "sound now plays on the monitor"
}

dock_off() {
  local prev=""
  main_restore
  sink_off
  route off 2>/dev/null
  if [ -f "$STATE/default" ]; then
    prev="$(cat "$STATE/default")"
    rm -f "$STATE/default"
  fi
  if [ -n "$prev" ]; then
    set_default "$prev"
  elif current_default | grep -qF "$SINK"; then
    # Nothing was chosen before: let WirePlumber pick again
    pw-metadata -d 0 default.configured.audio.sink >/dev/null
  fi
  say "monitor sound off"
}

watch() {
  local now was=""
  mkdir -p "$STATE"
  exec 9>"$STATE/lock"
  flock -n 9 || { say "already watching"; exit 0; }
  # Left over from a run that didn't get to clean up
  if [ -n "$(sink_id)" ] || [ -f "$STATE/main" ]; then
    dock_off
  fi
  trap 'dock_off; exit 0' TERM INT HUP
  while hyprctl version >/dev/null 2>&1; do
    now="$(connected_output)"
    if [ "$now" != "$was" ]; then
      if [ -n "$now" ]; then
        sleep 2  # let the link come up before starting sound
        dock_on "$now"
      else
        dock_off
      fi
      was="$now"
    fi
    sleep "$POLL"
  done
  [ -n "$was" ] && dock_off
}

status() {
  local out
  out="$(connected_output)"
  echo "monitor:  ${out:-none}"
  echo "mode:     $(dock_mode)$([ -f "$STATE/main" ] && echo " (drawn for $(cat "$STATE/main"))")"
  echo "route:    $(route_state || echo unknown)"
  echo "output:   $([ -n "$(sink_id)" ] && echo "Monitor (USB-C), node $(sink_id)" || echo none)"
  echo "default:  $(current_default)"
}

case "${1:-}" in
  watch) watch ;;
  on)
    out="$(connected_output)"
    [ -n "$out" ] || { say "no monitor connected"; exit 1; }
    dock_on "$out" ;;
  off) dock_off ;;
  status) status ;;
  mode)
    if [ -z "${2:-}" ]; then
      dock_mode
      exit 0
    fi
    case "$2" in
      match|smooth|rp5) ;;
      *) echo "usage: pocket-dock mode [match|smooth|rp5]" >&2; exit 2 ;;
    esac
    mkdir -p "$CONFIG"
    printf '%s\n' "$2" >"$CONFIG/dock-mode"
    out="$(connected_output)"
    [ -n "$out" ] && video_on "$out"
    exit 0 ;;
  *) echo "usage: pocket-dock watch|on|off|status|mode [match|smooth|rp5]" >&2; exit 2 ;;
esac
